[Unit]
Description=Dansal Calendar Server
After=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=dansal
Group=dansal
ExecStartPre=/usr/lib/dansal/dansal_preflight
ExecStart=/usr/bin/dansal --config /etc/dansal/config.yaml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
TimeoutStopSec=35

# systemd creates /run/dansal (socket), /var/lib/dansal (database + images)
# and /etc/dansal (config) with correct ownership before starting the service
RuntimeDirectory=dansal
RuntimeDirectoryMode=0750
StateDirectory=dansal
StateDirectoryMode=0750
ConfigurationDirectory=dansal
ConfigurationDirectoryMode=0750

# Security Hardening - Least Privilege
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
LockPersonality=true
RestrictRealtime=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service @clock @cpu-emulation @debug @keyring @module @mount @obsolete @raw-io @reboot @resources @setuid @swap
SystemCallArchitectures=native
MemoryDenyWriteExecute=true
RemoveIPC=true
PrivateUsers=true
ProtectHostname=true
ProtectProc=invisible
ReadWritePaths=/var/lib/dansal /run/dansal /etc/dansal
ReadOnlyPaths=/usr/share/zoneinfo /etc/ssl/certs
TemporaryFileSystem=/var/tmp
DevicePolicy=closed
DeviceAllow=char-pts rw
DeviceAllow=char-tty rw
DeviceAllow=char-random rw
DeviceAllow=char-urandom rw
DeviceAllow=char-null rw
DeviceAllow=char-zero rw
DeviceAllow=char-full rw
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_CHOWN CAP_FOWNER CAP_DAC_OVERRIDE CAP_SETGID CAP_SETUID
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
