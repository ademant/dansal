# Copy this file to .env and fill in the values.
# Run: cp .env.example .env && nano .env

# Public base URL of the dansal API (used in email links)
DANSAL_BASE_URL=https://cal.example.com

# Domain for the web frontend (without https://)
DANSAL_WEB_DOMAIN=cal.example.com

# Webmin session secret — generate with: openssl rand -hex 32
DANSAL_WEBMIN_SESSION_SECRET=change-me-generate-with-openssl-rand-hex-32

# SMTP (optional — leave blank to disable email)
DANSAL_SMTP_HOST=smtp.example.com
DANSAL_SMTP_PORT=587
DANSAL_SMTP_USER=noreply@example.com
DANSAL_SMTP_PASS=your-smtp-password
DANSAL_SMTP_FROM=noreply@example.com
