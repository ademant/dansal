#!/bin/sh
# Pre-flight checks run by systemd as ExecStartPre before dansal starts.
# Usage: dansal_preflight [CONFIG_PATH]
# Reads db_path and images_dir from the config; falls back to legacy defaults.

set -u

CONFIG="${1:-/etc/dansal/config.yaml}"
ERRORS=0
ME=$(id -un)

fail() {
    printf 'PREFLIGHT: %s\n' "$*" >&2
    ERRORS=$((ERRORS + 1))
}

stat_info() {
    stat -c 'owner=%U group=%G mode=%a' "$1" 2>/dev/null || printf '(stat failed)'
}

check_dir_writable() {
    path="$1"
    if [ ! -d "$path" ]; then
        fail "$path: directory does not exist"
    elif [ ! -w "$path" ]; then
        fail "$path: not writable by $ME — $(stat_info "$path")"
    fi
}

check_file_readable() {
    path="$1"
    if [ ! -f "$path" ]; then
        fail "$path: file does not exist"
    elif [ ! -r "$path" ]; then
        fail "$path: not readable by $ME — $(stat_info "$path")"
    fi
}

check_file_writable() {
    path="$1"
    if [ ! -e "$path" ]; then
        parent=$(dirname "$path")
        if [ ! -w "$parent" ]; then
            fail "$path: does not exist and parent directory not writable by $ME — $(stat_info "$parent")"
        fi
    elif [ ! -w "$path" ]; then
        fail "$path: not writable by $ME — $(stat_info "$path")"
    fi
}

# Extract a value from the YAML config by key name.
get_conf() {
    grep -E "^[[:space:]]*${1}:" "$CONFIG" 2>/dev/null | \
        sed 's/.*:[[:space:]]*//' | tr -d '"' | head -1
}

DB_PATH=$(get_conf "db_path")
DB_PATH="${DB_PATH:-/var/lib/dansal/calendar.db}"
IMAGES_DIR=$(get_conf "images_dir")
IMAGES_DIR="${IMAGES_DIR:-/var/lib/dansal/images}"
STATE_DIR=$(dirname "$DB_PATH")

check_dir_writable  "$STATE_DIR"
check_dir_writable  "$IMAGES_DIR"
check_file_writable "$DB_PATH"
check_file_readable "$CONFIG"

[ "$ERRORS" -eq 0 ] && exit 0

printf 'PREFLIGHT: %d check(s) failed — dansal will not start\n' "$ERRORS" >&2
exit 1
