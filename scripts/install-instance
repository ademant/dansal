#!/bin/bash
# install-instance — interactive first-time setup for a new dansal instance.
# Run as root from the dansal source directory.
# Usage: sudo scripts/install-instance
set -euo pipefail

# ── helpers ──────────────────────────────────────────────────────────────────

die()  { echo "error: $*" >&2; exit 1; }
info() { echo "  $*"; }

ask() {
    # ask <var> <prompt> [default]
    local var=$1 prompt=$2 default=${3:-}
    local display_default=""
    [[ -n $default ]] && display_default=" [$default]"
    while true; do
        read -rp "  ${prompt}${display_default}: " value
        value=${value:-$default}
        [[ -n $value ]] && break
        echo "  (required)"
    done
    printf -v "$var" '%s' "$value"
}

ask_optional() {
    # ask_optional <var> <prompt> [default]
    local var=$1 prompt=$2 default=${3:-}
    local display_default=""
    [[ -n $default ]] && display_default=" [$default]"
    read -rp "  ${prompt}${display_default}: " value
    printf -v "$var" '%s' "${value:-$default}"
}

ask_yn() {
    # ask_yn <prompt> [y|n default]  → returns 0 for yes, 1 for no
    local prompt=$1 default=${2:-y}
    local hint="[Y/n]"; [[ $default == n ]] && hint="[y/N]"
    read -rp "  ${prompt} ${hint}: " answer
    answer=${answer:-$default}
    [[ $answer =~ ^[Yy] ]]
}

free_port() {
    local port=$1
    while ss -tlnp 2>/dev/null | grep -qE ":${port}[[:space:]]"; do
        port=$((port + 1))
    done
    echo "$port"
}

section() { echo; echo "── $* ──────────────────────────────────────────────────"; }

# ── preflight ─────────────────────────────────────────────────────────────────

[[ $(id -u) -eq 0 ]] || die "run as root: sudo scripts/install-instance"
[[ -f Makefile ]] || die "run from the dansal source directory"
command -v openssl >/dev/null || die "openssl is required"

echo
echo "dansal instance installer"
echo "═══════════════════════════════════════════════════════════════"

# ── instance name ─────────────────────────────────────────────────────────────

section "Instance"
ask INSTANCE "Instance name (e.g. dev, test, prod)"

CONFDIR="/etc/dansal/${INSTANCE}"
[[ -f "${CONFDIR}/config.yaml" ]] && \
    die "instance '${INSTANCE}' already exists at ${CONFDIR} — this script is for first-time setup only"

# ── ports ─────────────────────────────────────────────────────────────────────

section "Ports"
info "Scanning for free ports..."

DEFAULT_API=$(free_port 8000)
DEFAULT_WEB=$(free_port 8080)
DEFAULT_WEBMIN=$(free_port 8090)

ask API_PORT    "API port"    "$DEFAULT_API"
ask WEB_PORT    "Web port"    "$DEFAULT_WEB"
ask WEBMIN_PORT "Webmin port" "$DEFAULT_WEBMIN"

# ── domains ───────────────────────────────────────────────────────────────────

section "Domains"
info "All services are served over https. Enter domain names only."
echo

ask WEB_DOMAIN "Web frontend domain (e.g. events.example.com)"

ask     API_DOMAIN    "API domain"    "api.${WEB_DOMAIN}"
ask_optional WEBMIN_DOMAIN "Webmin domain (leave blank to skip nginx config)" \
    "webmin.${WEB_DOMAIN}"

# ── mail ──────────────────────────────────────────────────────────────────────

section "Mail"

USE_LOCAL_MTA=false
SENDMAIL_BIN=$(command -v sendmail 2>/dev/null || true)
SMTP_HOST="" SMTP_PORT="587" SMTP_USER="" SMTP_PASSWORD="" SMTP_FROM=""

if [[ -n $SENDMAIL_BIN ]] && systemctl is-active postfix >/dev/null 2>&1; then
    info "Postfix is running (sendmail: ${SENDMAIL_BIN})."
    if ask_yn "Use local MTA instead of a network SMTP server?"; then
        USE_LOCAL_MTA=true
        ask SMTP_FROM "From address" "dansal@${WEB_DOMAIN}"
    fi
fi

if [[ $USE_LOCAL_MTA == false ]]; then
    ask_optional SMTP_HOST "SMTP host (leave blank to configure later)"
    if [[ -n $SMTP_HOST ]]; then
        ask_optional SMTP_PORT     "SMTP port"     "587"
        ask_optional SMTP_USER     "SMTP username"
        ask_optional SMTP_PASSWORD "SMTP password"
        ask          SMTP_FROM     "From address"  "dansal@${WEB_DOMAIN}"
    fi
fi

# ── instance identity ─────────────────────────────────────────────────────────

section "Instance identity (NodeInfo / federation metadata)"
info "These appear in fediverse crawlers and federation directories."
info "All fields are optional — press Enter to skip."
echo
ask_optional NODEINFO_DESCRIPTION    "Instance description (one line)"
ask_optional NODEINFO_MAINTAINER_NAME  "Maintainer name"
ask_optional NODEINFO_MAINTAINER_EMAIL "Maintainer email"

section "Security contact (/.well-known/security.txt)"
info "Used by security researchers to report vulnerabilities."
info "Enter a mailto: or https: URL, or leave blank to disable."
ask_optional SECURITY_CONTACT "Security contact"

# ── mTLS for webmin ───────────────────────────────────────────────────────────

section "Webmin mTLS"
info "mTLS restricts webmin access to browsers with a client certificate."
MTLS=false
if ask_yn "Generate a self-signed CA and client certificate for webmin?"; then
    MTLS=true
fi

# ── TLS certificates ──────────────────────────────────────────────────────────

section "TLS certificates (certbot / Let's Encrypt)"
info "Requires domains to already point to this server and port 80 accessible."
CERTBOT=false
if ask_yn "Obtain TLS certificates with certbot now?" n; then
    CERTBOT=true
fi

# ── confirm ───────────────────────────────────────────────────────────────────

section "Summary"
echo "  Instance : ${INSTANCE}"
echo "  API      : 127.0.0.1:${API_PORT}  (https://${API_DOMAIN})"
echo "  Web      : 127.0.0.1:${WEB_PORT}  (https://${WEB_DOMAIN})"
echo "  Webmin   : 127.0.0.1:${WEBMIN_PORT}${WEBMIN_DOMAIN:+  (https://${WEBMIN_DOMAIN})}"
if [[ $USE_LOCAL_MTA == true ]]; then
    echo "  Mail     : local MTA (${SENDMAIL_BIN}), from: ${SMTP_FROM}"
elif [[ -n $SMTP_HOST ]]; then
    echo "  Mail     : ${SMTP_HOST}:${SMTP_PORT}"
else
    echo "  Mail     : (not configured)"
fi
echo "  mTLS     : ${MTLS}"
echo "  Certbot  : ${CERTBOT}"
[[ -n $SECURITY_CONTACT ]] && echo "  Security : ${SECURITY_CONTACT}"
[[ -n $NODEINFO_DESCRIPTION ]] && echo "  NodeInfo : ${NODEINFO_DESCRIPTION}"
echo
ask_yn "Proceed?" y || { echo "Aborted."; exit 0; }

# ── setup-instance ────────────────────────────────────────────────────────────

section "Creating instance"
make setup-instance INSTANCE="$INSTANCE"

# ── patch config.yaml ─────────────────────────────────────────────────────────

CONFIG="${CONFDIR}/config.yaml"

sed -i "s|^  port: 8000|  port: ${API_PORT}|" "$CONFIG"
sed -i "s|base_url: \"\"|  base_url: \"https://${API_DOMAIN}\"|" "$CONFIG"

if [[ $USE_LOCAL_MTA == true ]]; then
    sed -i "s|  sendmail: \"\"|  sendmail: \"${SENDMAIL_BIN}\"|" "$CONFIG"
    sed -i "s|  from: \"\"|  from: \"${SMTP_FROM}\"|" "$CONFIG"
elif [[ -n $SMTP_HOST ]]; then
    sed -i "s|  host: \"\"|  host: \"${SMTP_HOST}\"|" "$CONFIG"
    sed -i "/^smtp:/,/^[^ ]/{s|^  port: .*|  port: ${SMTP_PORT}|}" "$CONFIG"
    [[ -n $SMTP_USER     ]] && sed -i "s|  username: \"\"|  username: \"${SMTP_USER}\"|" "$CONFIG"
    [[ -n $SMTP_PASSWORD ]] && sed -i "s|  password: \"\"|  password: \"${SMTP_PASSWORD}\"|" "$CONFIG"
    sed -i "s|  from: \"\"|  from: \"${SMTP_FROM}\"|" "$CONFIG"
fi

# ── patch web.yaml ────────────────────────────────────────────────────────────

WEB="${CONFDIR}/web.yaml"

sed -i "s|^listen: \"127.0.0.1:8080\"|listen: \"127.0.0.1:${WEB_PORT}\"|" "$WEB"
sed -i "s|^domain: \"events.example.com\"|domain: \"${WEB_DOMAIN}\"|" "$WEB"
sed -i "s|^dansal_url: \"http://127.0.0.1:8000\"|dansal_url: \"http://127.0.0.1:${API_PORT}\"|" "$WEB"

if [[ $USE_LOCAL_MTA == true ]]; then
    sed -i "s|# smtp_sendmail: \"\"|smtp_sendmail: \"${SENDMAIL_BIN}\"|" "$WEB"
elif [[ -n $SMTP_HOST ]]; then
    sed -i "s|# smtp_host: \"\"|smtp_host: \"${SMTP_HOST}\"|" "$WEB"
fi

[[ -n $NODEINFO_DESCRIPTION    ]] && sed -i "s|^nodeinfo_description: \"\"|nodeinfo_description: \"${NODEINFO_DESCRIPTION}\"|" "$WEB"
[[ -n $NODEINFO_MAINTAINER_NAME  ]] && sed -i "s|^nodeinfo_maintainer_name: \"\"|nodeinfo_maintainer_name: \"${NODEINFO_MAINTAINER_NAME}\"|" "$WEB"
[[ -n $NODEINFO_MAINTAINER_EMAIL ]] && sed -i "s|^nodeinfo_maintainer_email: \"\"|nodeinfo_maintainer_email: \"${NODEINFO_MAINTAINER_EMAIL}\"|" "$WEB"
[[ -n $SECURITY_CONTACT ]] && sed -i "s|# security_contact: \"\"|security_contact: \"${SECURITY_CONTACT}\"|" "$WEB"

# ── patch webmin.yaml ─────────────────────────────────────────────────────────

WEBMIN="${CONFDIR}/webmin.yaml"
SESSION_SECRET=$(openssl rand -hex 32)

sed -i "s|^listen: \"127.0.0.1:8090\"|listen: \"127.0.0.1:${WEBMIN_PORT}\"|" "$WEBMIN"
sed -i "s|^dansal_url: \"http://127.0.0.1:8000\"|dansal_url: \"http://127.0.0.1:${API_PORT}\"|" "$WEBMIN"
sed -i "s|session_secret: \"\"|session_secret: \"${SESSION_SECRET}\"|" "$WEBMIN"
if [[ -n $WEBMIN_DOMAIN ]]; then
    sed -i "s|# webmin_domain: \"webmin.example.com\"|webmin_domain: \"${WEBMIN_DOMAIN}\"|" "$WEBMIN"
fi

info "Configs written to ${CONFDIR}/"

# ── mTLS certificates ─────────────────────────────────────────────────────────

if [[ $MTLS == true ]]; then
    section "Generating mTLS certificates"
    MTLS_DIR="${CONFDIR}/mtls"
    install -d -m 750 -o root -g dansal "$MTLS_DIR"

    openssl genrsa -out "${MTLS_DIR}/ca.key" 4096 2>/dev/null
    openssl req -new -x509 -days 3650 \
        -key "${MTLS_DIR}/ca.key" \
        -out "${MTLS_DIR}/ca.crt" \
        -subj "/CN=dansal-webmin-${INSTANCE}-ca" 2>/dev/null
    chmod 640 "${MTLS_DIR}/ca.key"

    CERT_CN=$(cat /dev/urandom | tr -dc 'a-z' | head -c 12)

    openssl genrsa -out "${MTLS_DIR}/client.key" 4096 2>/dev/null
    openssl req -new \
        -key "${MTLS_DIR}/client.key" \
        -out "${MTLS_DIR}/client.csr" \
        -subj "/CN=${CERT_CN}" 2>/dev/null
    openssl x509 -req -days 3650 \
        -in  "${MTLS_DIR}/client.csr" \
        -CA  "${MTLS_DIR}/ca.crt" \
        -CAkey "${MTLS_DIR}/ca.key" \
        -CAcreateserial \
        -out "${MTLS_DIR}/client.crt" 2>/dev/null
    rm -f "${MTLS_DIR}/client.csr" "${MTLS_DIR}/ca.srl"

    P12="${HOME}/dansal-webmin-${INSTANCE}.p12"
    ask P12_PASSWORD "Password for p12 browser import (any word or phrase)"
    openssl pkcs12 -export \
        -in    "${MTLS_DIR}/client.crt" \
        -inkey "${MTLS_DIR}/client.key" \
        -out   "$P12" \
        -passout "pass:${P12_PASSWORD}" 2>/dev/null
    chmod 600 "$P12"

    info "CA cert    : ${MTLS_DIR}/ca.crt"
    info "Client p12 : ${P12}  (password: ${P12_PASSWORD})"
    echo
    echo "  Certificate CN: ${CERT_CN}"
    echo "  Webmin auto-login matches the CN against admin user emails."
    echo "  Create the first admin user with this email:"
    echo
    echo "    /usr/lib/dansal/${INSTANCE}/dansal_admin create-user --email ${CERT_CN} --role admin"
    echo
    echo
    info "Add to your nginx webmin server block:"
    info "  ssl_client_certificate ${MTLS_DIR}/ca.crt;"
    info "  ssl_verify_client on;"
fi

# ── binaries ──────────────────────────────────────────────────────────────────

section "Binaries"

BINDIR="/usr/lib/dansal/${INSTANCE}"
install -d -m 755 "$BINDIR"

if [[ -f ./dansal && -f ./dansal_web && -f ./dansal_webmin && -f ./dansal_admin ]]; then
    info "Local build artifacts found — installing..."
    make deploy INSTANCE="$INSTANCE"
elif [[ -f /usr/bin/dansal && -f /usr/bin/dansal-web ]]; then
    info "Package binaries found in /usr/bin/ — copying to instance directory..."
    install -m 755 /usr/bin/dansal        "${BINDIR}/dansal"
    install -m 755 /usr/bin/dansal_admin  "${BINDIR}/dansal_admin"
    install -m 755 /usr/bin/dansal-web    "${BINDIR}/dansal-web"
    install -m 755 /usr/bin/dansal-webmin "${BINDIR}/dansal-webmin"
    systemctl restart "dansal@${INSTANCE}"
    systemctl try-restart "dansal-web@${INSTANCE}.service"    || true
    systemctl try-restart "dansal-webmin@${INSTANCE}.service" || true
else
    echo
    echo "  No binaries found. Build them as a regular user, then deploy:"
    echo
    echo "    make build"
    echo "    sudo make deploy INSTANCE=${INSTANCE}"
    echo
fi

# ── certbot ───────────────────────────────────────────────────────────────────

if [[ $CERTBOT == true ]]; then
    section "TLS certificates"

    if ! command -v certbot >/dev/null 2>&1; then
        info "certbot not found — installing..."
        apt-get install -y certbot python3-certbot-nginx
    fi

    # Use --nginx plugin if nginx is running, standalone otherwise
    if systemctl is-active nginx >/dev/null 2>&1; then
        CERTBOT_METHOD="--nginx"
    else
        info "nginx is not running — using standalone mode (port 80 must be free)"
        CERTBOT_METHOD="--standalone"
    fi

    certbot_domain() {
        local domain=$1
        info "Obtaining certificate for ${domain}..."
        certbot certonly ${CERTBOT_METHOD} -d "${domain}" --non-interactive --agree-tos \
            --register-unsafely-without-email || {
            echo "  Warning: certbot failed for ${domain} — skipping"
            return 1
        }
    }

    CERTS_OK=true

    certbot_domain "${WEB_DOMAIN}" || CERTS_OK=false

    # API domain only needs its own cert when it differs from the web domain
    if [[ "${API_DOMAIN}" != "${WEB_DOMAIN}" ]]; then
        certbot_domain "${API_DOMAIN}" || CERTS_OK=false
    fi

    if [[ -n $WEBMIN_DOMAIN && "${WEBMIN_DOMAIN}" != "${WEB_DOMAIN}" ]]; then
        certbot_domain "${WEBMIN_DOMAIN}" || CERTS_OK=false
    fi

    if [[ $CERTS_OK == true ]]; then
        info "Deploying nginx configurations..."
        make deploy-nginx INSTANCE="${INSTANCE}"
        [[ -n $WEBMIN_DOMAIN ]] && make deploy-nginx-webmin INSTANCE="${INSTANCE}"
        info "Certbot auto-renewal is handled by the certbot systemd timer."
        info "Check with: systemctl status certbot.timer"
    else
        echo
        echo "  One or more certificates could not be obtained."
        echo "  Resolve DNS/port issues, then run manually:"
        echo "    certbot certonly --nginx -d ${WEB_DOMAIN}"
        [[ "${API_DOMAIN}" != "${WEB_DOMAIN}" ]] && \
            echo "    certbot certonly --nginx -d ${API_DOMAIN}"
        [[ -n $WEBMIN_DOMAIN ]] && \
            echo "    certbot certonly --nginx -d ${WEBMIN_DOMAIN}"
        echo "    sudo make deploy-nginx INSTANCE=${INSTANCE}"
        [[ -n $WEBMIN_DOMAIN ]] && \
            echo "    sudo make deploy-nginx-webmin INSTANCE=${INSTANCE}"
    fi
fi

# ── done ──────────────────────────────────────────────────────────────────────

section "Done"
echo "  Instance '${INSTANCE}' is ready."
echo
echo "  Config files (review before starting):"
echo "    ${CONFDIR}/config.yaml"
echo "    ${CONFDIR}/web.yaml"
echo "    ${CONFDIR}/webmin.yaml"
echo
if [[ $CERTBOT == false ]]; then
    echo "  To set up nginx and TLS later:"
    echo "    certbot certonly --nginx -d ${WEB_DOMAIN}"
    [[ "${API_DOMAIN}" != "${WEB_DOMAIN}" ]] && \
        echo "    certbot certonly --nginx -d ${API_DOMAIN}"
    [[ -n $WEBMIN_DOMAIN ]] && \
        echo "    certbot certonly --nginx -d ${WEBMIN_DOMAIN}"
    echo "    sudo make deploy-nginx INSTANCE=${INSTANCE}"
    [[ -n $WEBMIN_DOMAIN ]] && \
        echo "    sudo make deploy-nginx-webmin INSTANCE=${INSTANCE}"
    echo
fi
echo "  Start timers when ready:"
echo "    sudo systemctl start dansal-fetch@${INSTANCE}.timer dansal-backup@${INSTANCE}.timer"
echo
